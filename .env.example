# Copy to .env and export before running, or pass inline.
# Every value has a safe default; nothing here is required to start.

# ---- server ----
PORT=4000
TM_ADMINS=                       # comma-separated usc.edu addresses; empty = admin endpoints closed
TM_EMAIL_DOMAIN=usc.edu
NODE_ENV=                        # set to production to disable every demo convenience below
TM_DEMO_CODE=482913              # local dev sign-in code; ignored when NODE_ENV=production, except on Vercel where setting it enables it
TM_SIMULATED_ID=                 # simulated digital ID; default on in dev, off in production

# ---- digital ID verification (Credence ID Cloud SDK) ----
# Leave the key empty to use the simulated adapter (UI shows "Demo verification").
# Real calls need PUBLIC_ORIGIN to be the public https origin registered for the
# license in the Credence portal (a deployed URL or an HTTPS tunnel; localhost is rejected).
CREDENCE_BASE_URL=https://credenceid.com/cloudsdk/playground
CREDENCE_LICENSE_KEY=            # CS-xxxxxxxx-... server-side secret, never sent to the browser
CREDENCE_PROFILE_ID=
PUBLIC_ORIGIN=                   # e.g. https://your-app.example.com
CREDENCE_TIMEOUT_MS=15000
TM_SESSION_TTL_MS=2592000000
TM_SESSION_SECRET=               # signs session tokens; set a long random value on Vercel
TM_STATELESS_SESSIONS=           # signed tokens any instance can verify; default on when VERCEL is set

# ---- storage ----
# Mutable application state. Used only when TM_MONGO_URI is EMPTY.
TM_DB_FILE=server/db.json
TM_DATA_DIR=server/data

# Append-only behavioural event log. ALWAYS a file — never moved to MongoDB.
# Different data, different guarantees: it is immutable and rebuilt into
# training datasets offline. See docs/ML_ARCHITECTURE.md.
TM_EVENT_LOG=server/data/events.jsonl

# ---- MongoDB (OPT-IN) ----
# Leave TM_MONGO_URI empty for the zero-dependency file store — that is the
# default, and what the test suite runs against.
# Set it to switch the application-state store to MongoDB. If the URI is set but
# unreachable, the app logs the failure and boots on in-memory state rather than
# crashing (nothing persists until the database comes back).
TM_MONGO_URI=
TM_MONGO_DB=trojan_market
TM_MONGO_TIMEOUT_MS=5000

# ---- recommendations ----
TM_REC_LIMIT=20
TM_REC_POOL=400

# ---- ML: all OFF by default. This is the correct launch configuration. ----
TM_ML_ENABLED=false              # true only once a model is registered
TM_ML_URL=                       # e.g. http://localhost:8500
TM_ML_TIMEOUT_MS=120             # hard timeout; exceeded -> heuristic fallback
TM_ML_WEIGHT=0                   # 0 = pure heuristic. Ramp 0 -> 0.2 -> 0.5 -> 1.0
TM_MODEL_DIR=ml/artifacts
TM_REGISTRY_FILE=ml/artifacts/registry.json

# ---- confidence gates: a model that fails ANY of these cannot serve ----
TM_GATE_EXAMPLES=50000
TM_GATE_USERS=300
TM_GATE_SESSIONS=2000
TM_GATE_POSITIVES=2000
TM_GATE_NDCG=0.30
TM_GATE_LIFT=0.02

# ---- controlled exploration (position-bias correction) ----
TM_EXPLORE=false
TM_EXPLORE_TRAFFIC=0.05          # 5% of traffic gets a top-N swap
TM_EXPLORE_DEPTH=5

# ---- ingestion limits ----
TM_EVENT_BATCH_MAX=100
TM_RATE_WINDOW_MS=10000
TM_RATE_MAX=300
TM_JOB_INTERVAL_MS=60000
